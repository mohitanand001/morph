#!/usr/bin/env bash
# morph: install, start and stop Morph from anywhere.
#
#   morph --install     one-time setup (also after updating the files)
#   morph --start       start it (restarts it if already running)
#   morph --stop        quit it
#   morph --restart     stop, then start
#   morph --update      fetch the newest version from the website and install it
#   morph --status      is it running, is the GNOME helper installed
#   morph --setup       show the welcome card again
#   morph --enable-ocr  optional: read tables from copied images (installs RapidOCR for this account, ~400 MB)
#   morph --disable-ocr remove that again
#   morph --uninstall   remove everything: the program, helper, settings, logs, caches and this folder
set -u

# Follow the symlink in ~/.local/bin back to the real app folder.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
APP_DIR="$(cd "$(dirname "$SELF")/.." && pwd)"
EXT_UUID="morph-focus@morph.dev"
EXT_SRC="$APP_DIR/gnome-extension/$EXT_UUID"
EXT_DEST="${HOME}/.local/share/gnome-shell/extensions/$EXT_UUID"
BIN_DIR="${HOME}/.local/bin"
LOG="${XDG_CACHE_HOME:-$HOME/.cache}/morph.log"
AUTOSTART="${XDG_CONFIG_HOME:-$HOME/.config}/autostart/morph.desktop"
MAIN="$APP_DIR/daemon/gjs-main.js"
# Installed from the .deb (files under /usr): the package puts the command on PATH and starts Morph at login,
# so --install only sets up the per-user GNOME helper.
IS_PKG=0
case "$APP_DIR" in /usr/*|/opt/*) IS_PKG=1 ;; esac
# Optional table OCR lives apart from the app folder so an update never throws it away.
OCR_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/morph-ocr"
# Everything table OCR downloads stays inside OCR_DIR: its own Python environment, and for the OCR runs a home
# folder of its own, so any cache the libraries keep lands there too. An OCR package you installed yourself,
# and its caches, are never used or touched.
ocr_run() { mkdir -p "$OCR_DIR/home"; env HOME="$OCR_DIR/home" PYTHONNOUSERSITE=1 "$@"; }
UPDATE_URL="${MORPH_UPDATE_URL:-https://mohitanand001.github.io/morph/version.json}"

say() { printf '%s\n' "$*"; }

# ---- Only ever touch what is Morph's
# Other programs can use the same names (a "morph" command, a "formatter" settings folder), so nothing is
# overwritten or deleted unless it carries Morph's mark.
ours_settings() { grep -qs '"pillMode"' "$1"; }                       # a settings file Morph (or its earlier version) wrote
ours_desktop() { grep -qs 'daemon/gjs-main.js\|formatter-linker\|format-bridge' "$1"; }   # an autostart entry that starts Morph
ours_link() {                                                          # ~/.local/bin/morph pointing at a Morph folder
  [ -L "$1" ] || return 1
  t="$(readlink -f "$1" 2>/dev/null)" || return 1
  [ -f "$(dirname "$(dirname "$t")")/daemon/gjs-main.js" ]
}
# ---- Deleting: only files, only by name
# Morph never deletes a folder with what is inside it. It deletes the files a list names, one by one, and then
# the folders those leave empty (rmdir, which refuses any folder that still holds something). A file that no list
# names is never touched, so a folder with anything else in it stays, and Morph says where.
#   delete_listed <folder> <list>   the list holds paths relative to <folder>, one per line
delete_listed() {
  base="$1"; list="$2"
  [ -d "$base" ] && [ -f "$list" ] || return 0
  while IFS= read -r f; do
    case "$f" in ''|/*|../*|*/../*|*/..|..) continue ;; esac   # never a path that climbs out of <folder>
    [ -d "$base/$f" ] && [ ! -L "$base/$f" ] && continue        # folders go only once empty, below
    rm -f -- "$base/$f"
  done < "$list"
  prune_empty "$base"
}
# Removes the empty folders under <folder>, deepest first, and <folder> itself if it ends up empty.
prune_empty() { [ -d "$1" ] && find "$1" -depth -type d -empty -exec rmdir -- {} \; 2>/dev/null; return 0; }
# Writes the list of every file Morph has put in a folder it created (image tables), so it can be taken out by name.
record_files() { [ -d "$1" ] || return 0; (cd "$1" && { find . \( -type f -o -type l \) ! -name MANIFEST -print | sed 's#^\./##'; echo MANIFEST; }) > "$1/MANIFEST.new" && mv -f "$1/MANIFEST.new" "$1/MANIFEST"; }
left_note() { [ -d "$1" ] && say "Kept $1: it holds files Morph did not put there. Look inside and delete what you don't need." ; return 0; }
# The GNOME helper's folder: the files --install writes there, by name.
remove_helper_dir() {
  [ -d "$1" ] || return 0
  rm -f -- "$1/extension.js" "$1/metadata.json" "$1/stylesheet.css" "$1/impl.txt" "$1"/impl-*.js
  prune_empty "$1"
}

running() { pgrep -f "gjs.*$MAIN" >/dev/null 2>&1; }

# The GNOME helper is installed in two parts: a tiny loader (extension.js, never changes) and the real
# code under a name that carries its fingerprint (impl-XXXXXXXX.js). A new fingerprint can be loaded
# by turning the extension off and on, which avoids a log out.
ext_impl_name() { printf 'impl-%s.js' "$(sha256sum "$EXT_SRC/extension.js" | cut -c1-8)"; }
ext_hot() { grep -q 'FB-LOADER' "$EXT_DEST/extension.js" 2>/dev/null; }
ext_current() {
  [ -d "$EXT_DEST" ] || return 1
  ext_hot || return 1
  [ "$(cat "$EXT_DEST/impl.txt" 2>/dev/null)" = "$(ext_impl_name)" ] && [ -f "$EXT_DEST/$(ext_impl_name)" ] || return 1
  for f in metadata.json stylesheet.css; do
    cmp -s "$EXT_SRC/$f" "$EXT_DEST/$f" || return 1
  done
}

# The earlier, Electron-based version (if this account ever had it): stop it so the two never run together.
retire_old() {
  for f in "${XDG_CONFIG_HOME:-$HOME/.config}/autostart/format-bridge.desktop" "${XDG_CONFIG_HOME:-$HOME/.config}/autostart/formatter.desktop"; do
    ours_desktop "$f" && rm -f "$f"
  done
}

do_stop() {
  if running; then
    pkill -f "gjs.*$MAIN" 2>/dev/null
    sleep 0.5
    say "Stopped."
  else
    say "Not running."
  fi
}

do_start() {
  command -v gjs >/dev/null 2>&1 || { say "GNOME's script runner (gjs) is missing. On Ubuntu:  sudo apt install gjs"; exit 1; }
  [ -f "$MAIN" ] || { say "Not installed here. Run:  morph --install"; exit 1; }
  retire_old
  running && { pkill -f "gjs.*$MAIN" 2>/dev/null; sleep 0.5; }
  mkdir -p "$(dirname "$LOG")"
  cd "$APP_DIR" || exit 1
  nohup gjs -m "$MAIN" >"$LOG" 2>&1 &
  disown
  sleep 1.5
  if ! running; then
    say "It stopped right away. Last lines of the log ($LOG):"
    tail -n 8 "$LOG" 2>/dev/null | sed 's/^/    /'
    exit 1
  fi
  say "Morph is running.  (log: $LOG)"
  if command -v gnome-extensions >/dev/null 2>&1 && ! ext_current; then
    say "Note: the GNOME helper is out of date. Run  morph --install  to update it."
  fi
}

do_install() {
  say "Installing Morph from $APP_DIR"
  if ! command -v gjs >/dev/null 2>&1; then
    say "GNOME's script runner (gjs) is needed. On Ubuntu, Fedora and most GNOME systems it is already there."
    say "If not:  sudo apt install gjs   (Fedora: sudo dnf install gjs)"
    exit 1
  fi
  if ! command -v gnome-extensions >/dev/null 2>&1; then
    say "This version works on the GNOME desktop (Ubuntu's default, Fedora Workstation). It looks like this isn't GNOME."
    exit 1
  fi
  retire_old

  # Image tables installed by an earlier version had no list of their files yet. The folder is Morph's alone
  # (Morph made it and marked it), so its files are listed once now, to be removed by name later.
  if [ -f "$OCR_DIR/engine" ] && [ "$(cat "$OCR_DIR/engine" 2>/dev/null)" = rapidocr ] && [ ! -f "$OCR_DIR/MANIFEST" ]; then record_files "$OCR_DIR"; fi

  # A first install has no command, helper or autostart yet. Settings found then were left by an earlier
  # uninstall, so they are stale: clear them, and the welcome card shows as it should.
  STALE_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/morph"
  if ours_settings "$STALE_CFG/settings.json" && [ ! -d "$EXT_DEST" ] && [ ! -e "$BIN_DIR/morph" ] && [ ! -f "$AUTOSTART" ]; then
    rm -f "$STALE_CFG/settings.json"; rmdir "$STALE_CFG" 2>/dev/null || true
    say "- cleared settings left over from an earlier uninstall"
  fi

  if [ "$IS_PKG" = 0 ]; then
  # The command itself, on your PATH.
  chmod +x "$SELF"
  mkdir -p "$BIN_DIR"
  if [ -e "$BIN_DIR/morph" ] && ! ours_link "$BIN_DIR/morph"; then
    say "- $BIN_DIR/morph belongs to another program, so it was left alone. Run Morph as:  $SELF"
  else
    ln -sf "$SELF" "$BIN_DIR/morph"
    say "- command installed: $BIN_DIR/morph"
  fi
  case ":$PATH:" in
    *":$BIN_DIR:"*) ;;
    *)
      if ! grep -qs 'morph PATH' "$HOME/.bashrc"; then
        printf '\n# morph PATH\nexport PATH="$HOME/.local/bin:$PATH"\n' >> "$HOME/.bashrc"
      fi
      say "- added $BIN_DIR to PATH in ~/.bashrc (open a new terminal for it to count)"
      ;;
  esac
  fi

  # Settings from the earlier version, once.
  NEW_CFG="${XDG_CONFIG_HOME:-$HOME/.config}/morph"
  if [ ! -f "$NEW_CFG/settings.json" ]; then
    for old in "${XDG_CONFIG_HOME:-$HOME/.config}/formatter/settings.json" "${XDG_CONFIG_HOME:-$HOME/.config}/Format Bridge/settings.json" "${XDG_CONFIG_HOME:-$HOME/.config}/format-bridge/settings.json"; do
      if ours_settings "$old"; then mkdir -p "$NEW_CFG" && cp "$old" "$NEW_CFG/settings.json" && say "- kept your settings from the earlier version"; break; fi
    done
  fi

  if [ "$IS_PKG" = 0 ]; then
  # Start at login (a few seconds late, so GNOME has loaded its helper first).
  mkdir -p "$(dirname "$AUTOSTART")"
  if [ -f "$AUTOSTART" ] && ! ours_desktop "$AUTOSTART"; then
    say "- $AUTOSTART belongs to another program; Morph will not start at login until it is moved"
  else
  printf '%s\n' '[Desktop Entry]' 'Type=Application' 'Name=Morph' 'Comment=Paste formatted content correctly anywhere' \
    "Exec=gjs -m \"$MAIN\"" 'X-GNOME-Autostart-enabled=true' 'X-GNOME-Autostart-Delay=4' 'Terminal=false' > "$AUTOSTART"
  say "- starts at login"
  fi
  fi

  # The GNOME helper (draws the pill, reads the clipboard, grabs the shortcuts).
  NEEDS_LOGIN=0
  if ext_current; then
    say "- GNOME helper already up to date"
  else
    WAS_HOT=0; ext_hot && WAS_HOT=1
    impl="$(ext_impl_name)"
    if [ ! -d "$EXT_DEST" ]; then
      # A new folder is built out of sight and moved into place in one step. GNOME loads an extension the moment
      # its folder shows up (it may already be on its enabled list from an earlier install), so the folder must
      # never be seen half-written.
      mkdir -p "$(dirname "$EXT_DEST")"
      STAGE="$(mktemp -d "$(dirname "$(dirname "$EXT_DEST")")/.morph-stage.XXXXXX")" || { say "Couldn't prepare the GNOME helper."; exit 1; }
      cp "$EXT_SRC/extension.js" "$STAGE/$impl"
      cp "$EXT_SRC/loader.js" "$STAGE/extension.js"
      cp "$EXT_SRC/metadata.json" "$EXT_SRC/stylesheet.css" "$STAGE/"
      printf '%s' "$impl" > "$STAGE/impl.txt"
      mv "$STAGE" "$EXT_DEST"
    else
      # An existing folder: real code and pointer first, the files GNOME looks at last.
      cp "$EXT_SRC/extension.js" "$EXT_DEST/$impl"
      cp "$EXT_SRC/stylesheet.css" "$EXT_DEST/"
      printf '%s' "$impl" > "$EXT_DEST/impl.txt"
      cp "$EXT_SRC/metadata.json" "$EXT_DEST/"
      cp "$EXT_SRC/loader.js" "$EXT_DEST/extension.js"
    fi
    for old in "$EXT_DEST"/impl-*.js; do [ "$(basename "$old")" = "$impl" ] || rm -f "$old"; done
    if [ "$WAS_HOT" = 1 ]; then
      # The running helper can load the new code itself: off and on again, no log out.
      gnome-extensions disable "$EXT_UUID" 2>/dev/null || true
      sleep 0.5
      gnome-extensions enable "$EXT_UUID" 2>/dev/null || true
      sleep 0.5
      say "- GNOME helper updated (no log out needed)"
    else
      # A brand-new extension: GNOME notices the folder after a moment, then it can be switched on, no log out.
      # Try for up to ~12 s; if it never goes active we print the one command that switches it on.
      NEEDS_LOGIN=1
      i=0
      while [ "$i" -lt 24 ]; do
        gnome-extensions enable "$EXT_UUID" 2>/dev/null || true
        if gnome-extensions info "$EXT_UUID" 2>/dev/null | grep -qE 'State:[[:space:]]*(ACTIVE|ENABLED)'; then NEEDS_LOGIN=0; break; fi
        sleep 0.5; i=$((i + 1))
      done
      if [ "$NEEDS_LOGIN" = 0 ]; then say "- GNOME helper installed and switched on (no log out needed)"; else say "- GNOME helper installed"; fi
    fi
  fi
  say ""
  if [ "$NEEDS_LOGIN" = 1 ]; then
    say "Done. GNOME hasn't switched the helper on yet. Run this once it has noticed it:"
    say "  gnome-extensions enable $EXT_UUID"
    # Already running (an update)? Restart it now so the new program is in use.
    if running; then do_start; fi
  else
    do_start
    say ""
    say "Done."
  fi
}

# Uninstall means gone: the program, its helper, its settings, logs, caches and the folder it runs from.
# (The pill's Uninstall button runs this too; --purge is kept as the same thing under its old name.)
do_uninstall() {
  # Only ever delete a folder that really is Morph's.
  if [ -f "$APP_DIR/daemon/gjs-main.js" ] && [ -f "$APP_DIR/bin/morph" ] && grep -q '"name": "morph"' "$APP_DIR/package.json" 2>/dev/null && [ "$APP_DIR" != "$HOME" ] && [ "$APP_DIR" != "/" ]; then
    SAFE_DIR=1
  else
    SAFE_DIR=0
  fi
  do_stop
  CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
  CACHE="${XDG_CACHE_HOME:-$HOME/.cache}"
  # Start at login and the command: only Morph's own.
  for f in "$AUTOSTART" "$CFG/autostart/formatter.desktop" "$CFG/autostart/format-bridge.desktop"; do ours_desktop "$f" && rm -f "$f"; done
  ours_link "$BIN_DIR/morph" && rm -f "$BIN_DIR/morph"
  ours_link "$BIN_DIR/formatter-linker" && rm -f "$BIN_DIR/formatter-linker"
  # The GNOME helpers (this one and the old Formatter one): switch off, forget, delete. Both names are Morph's own.
  for uuid in "$EXT_UUID" "format-bridge-focus@formatbridge.dev"; do
    dir="$HOME/.local/share/gnome-shell/extensions/$uuid"
    [ -d "$dir" ] && gnome-extensions disable "$uuid" 2>/dev/null || true
    remove_helper_dir "$dir"; left_note "$dir"
    if command -v gsettings >/dev/null 2>&1; then
      for key in enabled-extensions disabled-extensions; do
        cur="$(gsettings get org.gnome.shell "$key" 2>/dev/null || true)"
        case "$cur" in *"$uuid"*) gsettings set org.gnome.shell "$key" "$(printf '%s' "$cur" | sed "s/'$uuid', *//; s/, *'$uuid'//; s/'$uuid'//")" 2>/dev/null || true ;; esac
      done
    fi
  done
  # The two lines --install may have added to ~/.bashrc, exactly those, nothing else.
  if [ -f "$HOME/.bashrc" ]; then
    sed -i '/^# morph PATH$/{N;/\nexport PATH="\$HOME\/\.local\/bin:\$PATH"$/d}' "$HOME/.bashrc" 2>/dev/null || true
    sed -i '/^# formatter-linker PATH$/{N;/\nexport PATH=.*$/d}' "$HOME/.bashrc" 2>/dev/null || true
  fi
  # Settings: Morph's file only. A folder another program also uses keeps that program's files.
  for d in "$CFG/morph" "$CFG/formatter" "$CFG/format-bridge" "$CFG/Format Bridge"; do
    ours_settings "$d/settings.json" && { rm -f -- "$d/settings.json" "$d/settings.json.bak"; rmdir -- "$d" 2>/dev/null || true; }
  done
  rm -f "$CACHE/morph.log" "$CACHE/morph-ocr.log" "$CACHE/formatter-linker.log"
  # Image tables: Morph's own folder (its name is Morph's), and the private folder for copied images.
  remove_ocr_files; left_note "$OCR_DIR"
  [ -n "${XDG_RUNTIME_DIR:-}" ] && [ -d "$XDG_RUNTIME_DIR/morph" ] && { rm -f "$XDG_RUNTIME_DIR"/morph/clip-image*; rmdir "$XDG_RUNTIME_DIR/morph" 2>/dev/null || true; }
  if [ "$IS_PKG" = 1 ]; then
    say "Removed Morph's helper, settings, logs and caches for this account."
    if command -v pkexec >/dev/null 2>&1 && pkexec dpkg --purge morph >/dev/null 2>&1; then
      say "Morph is gone: the program, its settings, logs and caches."
    else
      say "The program itself belongs to the system. To finish removing it, run:  sudo apt remove --purge morph"
    fi
  elif [ "$SAFE_DIR" = 1 ]; then
    cd "$HOME" 2>/dev/null || cd /
    # Only what Morph's download contains. Anything else you put in this folder stays, and so does the folder.
    if [ -f "$APP_DIR/MANIFEST" ]; then delete_listed "$APP_DIR" "$APP_DIR/MANIFEST"; fi
    if [ -d "$APP_DIR" ]; then say "Morph is gone. $APP_DIR still holds files that are not Morph's, so it was left in place."
    else say "Morph is gone: the program, its settings, logs and caches."; fi
  else
    say "Removed Morph's settings, helper and caches. Left $APP_DIR alone (it doesn't look like a Morph folder). Delete it yourself if you want."
  fi
  exit 0
}

# The update's temporary folder: the zip, its file list and the files unzip wrote (named by the zip's own list).
clean_tmp() {
  [ -n "${tmp:-}" ] && [ -d "$tmp" ] || return 0
  [ -f "$tmp/files" ] && delete_listed "$tmp/x" "$tmp/files"
  rm -f -- "$tmp/new.zip" "$tmp/files" "$tmp/gone"
  prune_empty "$tmp"
}
json_field() { printf '%s' "$1" | sed -n "s/.*\"$2\": *\"\([^\"]*\)\".*/\1/p" | head -1; }

# Fetch the newest version from the website, check its fingerprint, copy it over this folder, reinstall.
do_update() {
  if [ "$IS_PKG" = 1 ]; then
    say "Morph was installed from a .deb. To update it, download the newer .deb and run:  sudo apt install ./morph_<version>_all.deb"
    exit 1
  fi
  for t in curl unzip sha256sum; do command -v "$t" >/dev/null 2>&1 || { say "Needs '$t'. On Ubuntu:  sudo apt install curl unzip"; exit 1; }; done
  cur="$(json_field "$(cat "$APP_DIR/package.json" 2>/dev/null)" version)"
  meta="$(curl -fsSL --max-time 15 "$UPDATE_URL")" || { say "Couldn't reach the update page ($UPDATE_URL)."; exit 1; }
  new="$(json_field "$meta" version)"; zip="$(json_field "$meta" zip)"; sha="$(json_field "$meta" sha256)"
  [ -n "$new" ] && [ -n "$zip" ] && [ -n "$sha" ] || { say "The update page didn't look right."; exit 1; }
  # Only a Morph zip, from the same website, with a real fingerprint: never a link to somewhere else.
  printf '%s' "$zip" | grep -Eq '^morph-[0-9A-Za-z.+-]+-linux\.zip$' || { say "The update page pointed somewhere unexpected, so nothing was installed."; exit 1; }
  printf '%s' "$sha" | grep -Eq '^[0-9a-f]{64}$' || { say "The update page didn't look right."; exit 1; }
  printf '%s' "$new" | grep -Eq '^[0-9A-Za-z.+-]{1,40}$' || { say "The update page didn't look right."; exit 1; }
  if [ "$new" = "$cur" ]; then say "Already up to date ($cur)."; exit 0; fi
  say "Updating $cur -> $new"
  url="${UPDATE_URL%/*}/$zip"
  tmp="$(mktemp -d)" || { say "Couldn't make a temporary folder."; exit 1; }
  trap 'clean_tmp' EXIT
  curl -fsSL --max-time 120 -o "$tmp/new.zip" "$url" || { say "Download failed."; exit 1; }
  echo "$sha  $tmp/new.zip" | sha256sum -c --quiet - || { say "The download didn't match its fingerprint, so it was not installed."; exit 1; }
  unzip -Z1 "$tmp/new.zip" > "$tmp/files" 2>/dev/null || { say "Couldn't unpack the download."; exit 1; }
  unzip -q "$tmp/new.zip" -d "$tmp/x" || { say "Couldn't unpack the download."; exit 1; }
  [ -f "$tmp/x/morph/daemon/gjs-main.js" ] || { say "The download didn't contain Morph."; exit 1; }
  # Files the old version had and the new one doesn't: taken out by name.
  if [ -f "$APP_DIR/MANIFEST" ] && [ -f "$tmp/x/morph/MANIFEST" ]; then
    grep -Fxv -f "$tmp/x/morph/MANIFEST" "$APP_DIR/MANIFEST" > "$tmp/gone" || true
    delete_listed "$APP_DIR" "$tmp/gone"; mkdir -p "$APP_DIR"
  fi
  cp -r "$tmp/x/morph/." "$APP_DIR/"
  chmod +x "$APP_DIR/bin/morph"
  say "Files replaced."
  [ -n "${FB_NO_INSTALL:-}" ] && exit 0
  clean_tmp; trap - EXIT
  exec "$APP_DIR/bin/morph" --install
}


# Optional: read tables out of copied images with RapidOCR. Private Python environment in one folder, removed by
# --disable-ocr. The only network use is this install: the packages from PyPI and the models, once. After that
# Morph runs it offline, and only when you click.
do_enable_ocr() {
  command -v python3 >/dev/null 2>&1 || { say "Needs python3. On Ubuntu:  sudo apt install python3 python3-venv"; exit 1; }
  python3 -c 'import venv, ensurepip' 2>/dev/null || { say "Needs python3-venv. On Ubuntu:  sudo apt install python3-venv"; exit 1; }
  # An older table OCR (PaddleOCR, about 3 GB) is replaced by the much smaller RapidOCR.
  # (Only a finished older install: a RapidOCR install that stopped half way is kept, so Try again resumes it.)
  if [ -f "$OCR_DIR/ready" ] && [ "$(cat "$OCR_DIR/engine" 2>/dev/null)" != rapidocr ]; then
    say "The older, larger image-tables version is in $OCR_DIR. Delete that folder yourself to free about 3 GB, then turn image tables on again."
    exit 1
  fi
  say "Image tables installs RapidOCR into $OCR_DIR (about 400 MB, one time, needs internet)."
  say "Nothing is sent anywhere when you use it. Remove it any time with:  morph --disable-ocr"
  mkdir -p "$OCR_DIR"; record_files "$OCR_DIR"
  # "Step n of 4" lines drive the progress bar in Settings → Image tables.
  say "Step 1 of 4: Preparing a private Python environment..."
  [ -x "$OCR_DIR/venv/bin/python" ] || python3 -m venv "$OCR_DIR/venv" || { say "Could not create the Python environment."; record_files "$OCR_DIR"; remove_ocr_files; exit 1; }
  record_files "$OCR_DIR"
  say "Step 2 of 4: Updating the Python installer..."
  "$OCR_DIR/venv/bin/python" -m pip install --quiet --no-cache-dir --upgrade pip || true
  say "Step 3 of 4: Installing RapidOCR..."
  # RapidOCR 2.x/3.x with the ONNX runtime; the older all-in-one package where that is not available.
  "$OCR_DIR/venv/bin/python" -m pip install --quiet --no-cache-dir "rapidocr>=2,<4" "onnxruntime>=1.16" \
    || "$OCR_DIR/venv/bin/python" -m pip install --quiet --no-cache-dir "rapidocr_onnxruntime>=1.3" \
    || { say "The install failed. Nothing was changed in Morph."; record_files "$OCR_DIR"; remove_ocr_files; exit 1; }
  record_files "$OCR_DIR"
  say "Step 4 of 4: Getting the text models ready (one time)..."
  # If this fails, the installed packages are kept: Try again only redoes this step.
  # The reason goes to ~/.cache/morph-ocr.log and its first line is shown in Settings.
  OCR_LOG="${XDG_CACHE_HOME:-$HOME/.cache}/morph-ocr.log"
  mkdir -p "$(dirname "$OCR_LOG")"
  warm="$(ocr_run "$OCR_DIR/venv/bin/python" "$APP_DIR/ocr/morph_ocr.py" --warmup 2>>"$OCR_LOG")"
  printf '%s\n' "$warm" >> "$OCR_LOG"
  if ! printf '%s' "$warm" | grep -q '"ok": true'; then
    why="$(printf '%s' "$warm" | sed -n 's/.*"detail": "\([^"]*\)".*/\1/p' | cut -c1-90)"
    say "Could not load the models${why:+: $why}. Details: $OCR_LOG"
    exit 1
  fi
  printf 'rapidocr' > "$OCR_DIR/engine"
  : > "$OCR_DIR/ready"
  record_files "$OCR_DIR"
  say "Image tables are on. Copy a screenshot of a table, then pick an app in Morph."
  exit 0
}
# Image tables' folder: the files Morph recorded as it installed them (Python's own __pycache__ files, which Python
# writes next to those, too), by name.
remove_ocr_files() {
  case "$OCR_DIR" in */morph-ocr) ;; *) return 0 ;; esac
  [ -f "$OCR_DIR/MANIFEST" ] || return 0
  { cat "$OCR_DIR/MANIFEST"; (cd "$OCR_DIR" && find . -path '*/__pycache__/*.pyc' -type f | sed 's#^\./##'); } > "$OCR_DIR/.remove"
  echo .remove >> "$OCR_DIR/.remove"
  delete_listed "$OCR_DIR" "$OCR_DIR/.remove"
}
do_disable_ocr() {
  remove_ocr_files; rm -f -- "${XDG_CACHE_HOME:-$HOME/.cache}/morph-ocr.log"
  if [ -d "$OCR_DIR" ]; then left_note "$OCR_DIR"; else say "Image tables removed."; fi
  exit 0
}

do_status() {
  if running; then say "App:    running"; else say "App:    not running"; fi
  if command -v gnome-extensions >/dev/null 2>&1; then
    if ext_current; then say "Helper: installed, up to date"; else say "Helper: missing or out of date (run --install)"; fi
    gnome-extensions info "$EXT_UUID" 2>/dev/null | grep -i "state" | sed 's/^ */Helper: /'
  fi
  if [ -f "$OCR_DIR/ready" ] && [ "$(cat "$OCR_DIR/engine" 2>/dev/null)" = rapidocr ]; then say "Table OCR: on"
  elif [ -f "$OCR_DIR/ready" ]; then say "Table OCR: the older, larger version (run morph --enable-ocr to switch to the small one)"
  else say "Table OCR: off (morph --enable-ocr to turn it on)"; fi
}

# Forget that setup was answered and start again: the welcome card opens as it did on the first run.
do_setup() {
  f="${XDG_CONFIG_HOME:-$HOME/.config}/morph/settings.json"
  do_stop >/dev/null 2>&1 || true
  if [ -f "$f" ]; then sed -i 's/"setupDone": *true/"setupDone": false/' "$f"; fi
  do_start
  say "The welcome card opens now."
}

case "${1:-}" in
  --setup)     do_setup ;;
  --install)   do_install ;;
  --session)   do_install ;;
  --start)     do_start ;;
  --stop)      do_stop ;;
  --restart)   do_stop; do_start ;;
  --update)    do_update ;;
  --status)    do_status ;;
  --enable-ocr)  do_enable_ocr ;;
  --disable-ocr) do_disable_ocr ;;
  --uninstall) do_uninstall ;;
  --purge)     do_uninstall ;;
  -h|--help|"") sed -n '2,13p' "$SELF" | sed 's/^# \{0,1\}//' ;;
  *) say "Unknown option: $1"; say "Try:  morph --help"; exit 2 ;;
esac
